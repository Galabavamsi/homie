{
  "name": "homie-api",
  "version": "1.0.0",
  "description": "Homie collaborative ordering API with mocked Swiggy MCP boundaries.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "dev:memory": "cross-env DATABASE_URL= REDIS_URL= nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --test --test-reporter=spec",
    "db:up": "docker compose -f ../../compose.yaml up -d --wait",
    "db:down": "docker compose -f ../../compose.yaml down",
    "demo:food": "node scripts/demo-food-flow.js",
    "record:demo": "node scripts/record-ui-demo.js",
    "lint": "node --check src/server.js && node --check src/routes/index.js && node --check src/services/CollaborationService.js && node --check src/data/PostgresCollaborationRepository.js && node --check scripts/record-ui-demo.js"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "pg": "^8.12.0",
    "redis": "^4.7.0",
    "socket.io": "^4.7.5",
    "uuid": "^14.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.4",
    "playwright": "^1.62.1",
    "socket.io-client": "^4.8.1"
  }
}
